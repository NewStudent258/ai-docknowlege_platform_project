# ============================================================
# DocMind — 环境变量配置模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：  cp backend/.env.example backend/.env
#   2. 填入实际凭证和配置
#   3. docker-compose 会自动从 backend/.env 读取环境变量
#
# 注意：.env 文件在 backend/ 目录下，不在项目根目录
# ============================================================

# ── 应用 ──
APP_NAME=DocMind
DEBUG=false
ENV=production

# ── MySQL ──
# Docker 部署时 MYSQL_HOST 设为服务名 "mysql"（docker-compose 内部 DNS 解析）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=docmind
MYSQL_PASSWORD=your_strong_password
MYSQL_DATABASE=docmind

# ── ChromaDB ──
# 容器内路径，通过 docker-compose 挂卷持久化
CHROMA_PERSIST_DIR=./chroma_data

# ── LLM（OpenAI 兼容接口 — DeepSeek）──
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-pro
LLM_FLASH_MODEL=deepseek-v4-flash

# ── Embedding（DashScope）──
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=text-embedding-v3

# ── Rerank（DashScope，Phase 5.5 启用）──
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_MODEL=qwen3-rerank

# ── JWT ──
# ⚠️ 生产环境必须更换为 64 字符随机字符串！
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_SECRET_KEY=

# ── Redis ──
# Docker 部署时 REDIS_URL 设为服务名 "redis"（docker-compose 内部 DNS 解析）
REDIS_URL=redis://redis:6379/0

# ── Celery ──
# Docker 部署时 broker/backend 使用 redis 服务名
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── 文件存储 ──
# 容器内路径，通过 docker-compose 挂卷持久化
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,docx,md,txt

# ── CORS ──
# 生产环境设为实际访问域名（Nginx 代理后浏览器看到的 URL）
# 多个域名逗号分隔，例如：https://docmind.example.com,https://doc.example.com
CORS_ORIGINS=http://localhost

# ── LightRAG（第三路检索，ADR-025）──
# 关闭时检索管线退回向量+BM25 双路，对现有链路零影响
LIGHTRAG_ENABLED=false
LIGHTRAG_TOP_K=10
LIGHTRAG_DATA_DIR=./lightrag_data
LIGHTRAG_QUERY_MODE=mix
# 实体/关系抽取用模型，建议用便宜的非推理模型
LIGHTRAG_LLM_MODEL=deepseek-flash
LIGHTRAG_CHUNK_TOKEN_SIZE=2000
LIGHTRAG_MAX_INSTANCES=4
LIGHTRAG_INSTANCE_TTL=300

# ── MCP Server（ADR-026）──
# 挂载于 MCP_PATH，复用 AuthMiddleware 做 JWT 鉴权
MCP_ENABLED=true
MCP_PATH=/mcp

# ── CoarseRank 粗排（ADR-024）──
# ⚠️ 默认 false。强干扰评测集消融实验显示粗排为负收益：
#    Hit@1 0.8471 → 0.8118，MRR 0.8970 → 0.8817。
#    根因是按向量相似度截断会挤掉 BM25 独有候选，使 RRF 融合退化回单路向量排序。
#    除非重新做参数扫描确认收益，否则不建议开启。详见 backend/ablation_eval.md
COARSE_RANK_ENABLED=false
COARSE_RANK_THRESHOLD=0.05
COARSE_TOP_K=10

